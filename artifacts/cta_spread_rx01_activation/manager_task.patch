+
+# RX01 mixed cash/perpetual Exec
+location /exec_trade06/config/ {
+    auth_request /manager-auth/exec_trade06;
+    proxy_pass http://127.0.0.1:18166/;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_connect_timeout 2s;
+    proxy_read_timeout 15s;
+    proxy_buffering off;
+}
+
+location = /exec_trade06 {
+    return 301 /exec_trade06/;
+}
+
+location /exec_trade06/ {
+    auth_request /manager-auth/exec_trade06;
+    proxy_pass http://127.0.0.1:10046/;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_set_header Upgrade $http_upgrade;
+    proxy_set_header Connection "upgrade";
+    proxy_connect_timeout 2s;
+    proxy_read_timeout 1h;
+    proxy_buffering off;
+}
+
+location = /manager-auth/exec_trade06 {
+    internal;
+    proxy_pass http://127.0.0.1:18201/api/auth/verify;
+    proxy_set_header Cookie $http_cookie;
+    proxy_set_header X-CTA-Source-ID binance_exec_trade06;
+    proxy_pass_request_body off;
+    proxy_set_header Content-Length "";
+}
