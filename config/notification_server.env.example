# Bind locally by default. Change only when remote producers are required.
NOTIFICATION_HOST=127.0.0.1
NOTIFICATION_PORT=18100

# Create the bot with @BotFather. Treat this token like a password.
TELEGRAM_BOT_TOKEN=

# Numeric private/group chat ID, or @channelusername for a channel.
TELEGRAM_CHAT_ID=

# Optional forum topic ID.
TELEGRAM_MESSAGE_THREAD_ID=

# Set to 1 to deliver without a notification sound.
TELEGRAM_DISABLE_NOTIFICATION=0

# Optional local API authentication. Producers may send Bearer or X-Notification-Token.
NOTIFICATION_API_TOKEN=

NOTIFICATION_QUEUE_CAPACITY=1024
# Telegram sendMessage accepts at most 4096 characters.
NOTIFICATION_MAX_MESSAGE_CHARS=4096
NOTIFICATION_REQUEST_TIMEOUT_MS=5000
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_DELAY_MS=500

# Set to 1 for local smoke tests without Telegram credentials.
NOTIFICATION_DRY_RUN=0
RUST_LOG=info
