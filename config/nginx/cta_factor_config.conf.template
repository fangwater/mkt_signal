# Render with scripts/render_cta_factor_config_nginx.py before installation.
location = /cta/cta-prep-binance-futures/config {
    return 303 /cta/cta-prep-binance-futures/config/;
}
location /cta/cta-prep-binance-futures/config/ {
    set $delist_original_method $request_method;
    auth_request /manager-auth/cta-factor-config;
    auth_request_set $parameter_actor $upstream_http_x_parameter_actor;
    proxy_set_header X-Parameter-Actor $parameter_actor;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:__CTA_CONFIG_PORT__/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store";
}
location = /manager-auth/cta-factor-config {
    internal;
    proxy_pass http://127.0.0.1:8787/auth/verify-cta;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Original-Method $delist_original_method;
    proxy_set_header X-CTA-Source-ID "__CTA_CONFIG_SOURCE_IDS__";
    proxy_set_header X-CTA-Access configure;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
}
# Retire the old editable configuration locations. Delist owns navigation.
location = /cta/binance-cta-perp-rx01/config { return 410; }
location ^~ /cta/binance-cta-perp-rx01/config/ { return 410; }
location = /cta/binance-cta-perp-rx03/config { return 410; }
location ^~ /cta/binance-cta-perp-rx03/config/ { return 410; }
location = /cta/binance-cta-perp-rx04/config { return 410; }
location ^~ /cta/binance-cta-perp-rx04/config/ { return 410; }

# Spread uses the same editor and permission boundary, selecting its own catalog.
location = /cta/cta-factor-spread/config { return 303 "/cta/cta-prep-binance-futures/config/?worker=cta-factor-spread"; }
location /cta/cta-factor-spread/config/ { return 303 "/cta/cta-prep-binance-futures/config/?worker=cta-factor-spread"; }
location = /cta/okex-binance-cta-spread-rx01/config { return 410; }
location ^~ /cta/okex-binance-cta-spread-rx01/config/ { return 410; }
location = /cta/binance-cta-spread-rx01/config { return 410; }
location ^~ /cta/binance-cta-spread-rx01/config/ { return 410; }
