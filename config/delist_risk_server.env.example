# HTTP bind. nginx 4191 反代到这个端口。
DELIST_BIND=127.0.0.1:8787
# Required: salted PBKDF2 login hash, public origin and the FR allowlist.
# Generate with scripts/configure_delist_access.py; never commit the real file.
# DELIST_ACCESS_CONFIG=/home/ubuntu/delist_risk_server/config/delist_access.json
DELIST_DAYS=30

# 轮询式下架检查每天一次。Gate announcement WS 是持续推送连接，不是轮询。
DELIST_ANNOUNCEMENT_INTERVAL_SECS=86400
DELIST_OFFICIAL_INTERVAL_SECS=86400
DELIST_LISTING_INTERVAL_SECS=86400

# 账户目录只从 NAV 读取，不在 delist_risk_server 内手写盘子清单。
DELIST_NAV_STRATEGIES_URL=http://127.0.0.1:4191/nav-api/strategies
DELIST_NAV_STRATEGY_INTERVAL_SECS=60

# Postgres。部署脚本会在 jp 上建库并写入实际 URL，不要提交密码。
DELIST_PG_URL=postgres://delist_risk:@127.0.0.1:5432/delist_risk

# Redis：JP 本机名单。
DELIST_REDIS_URL=redis://127.0.0.1:6379/0

# 每日按 FR 环境分别备份 Redis 配置、env.sh、trade_engine.toml 和 config/，排除历史备份文件。
# 默认保留最近 30 份；启动后补当天，失败每 5 分钟重试。SG 配置文件通过 SSH 读取。
# 包含凭据，备份目录和文件必须私有；不使用 Redis 复制命令。
# DELIST_REDIS_BACKUP_DIR=/home/ubuntu/delist_risk_server/data/redis_backups
# DELIST_REDIS_BACKUP_KEEP=30
# DELIST_REDIS_BACKUP_ENV_ROOT=/home/ubuntu
# DELIST_SKIP_REDIS_BACKUP=0
# 腾讯云 COS 备份：先建立服务用户私有的 rclone 配置；请勿把密钥写入此文件。
# DELIST_REDIS_BACKUP_COS_TARGET=tencent-fr:jp-fr-config-1307417638/fr-config-backups
# DELIST_REDIS_BACKUP_COS_CONFIG=/home/ubuntu/.config/rclone/fr-cos.conf
# 每日分别备份共享 CTA Prep／Spread 的完整配置、状态、仓位台账及关联 Exec；页面支持立即备份。
# DELIST_CTA_BACKUP_DIR=/home/ubuntu/delist_risk_server/data/cta_backups
# Shared factor environment: config/cta_prep_binance_futures.toml plus its
# combination directory; read-only discovery/backup, no Kafka subscription.
# DELIST_CTA_FACTOR_ENV=/home/ubuntu/cta-prep-binance-futures
# DELIST_CTA_SPREAD_FACTOR_ENV=/home/ubuntu/cta-factor-spread
# DELIST_CTA_BACKUP_COS_TARGET=tencent-fr:jp-fr-config-1307417638/lgq-cta-backup
# CTA Prep/Spread mapping uses the JP Manager database. Put
# DELIST_CTA_JP_DATABASE_URL in config/cta_manager_reader.env (mode 0600),
# using a database role with SELECT only on the five Manager mapping tables.

# 完整目录确认账户任一交易腿已下架后，从该账户全部 symbol list 删除。
# 删除前后写入本机 Postgres redis_symbol_removal_audit；PG 不可用时不改 Redis。
DELIST_AUTO_REMOVE_REDIS=0

# FR 盘命中未来停止开仓/下架事件且对应腿实际仓位 >= 50U 时：
# 从 fwd/bwd open 原子移除并加入 dump。只读取本机 snapshot，不增加交易所轮询。
# PostgreSQL 不可用、snapshot 超时/陈旧、Redis 并发变化时均不修改配置。
DELIST_AUTO_DUMP_POSITION_RISK=1
DELIST_POSITION_RISK_INTERVAL_SECS=60
DELIST_POSITION_RISK_THRESHOLD_USDT=50
DELIST_POSITION_SNAPSHOT_MAX_AGE_SECS=120
DELIST_SNAPSHOT_BASE_URL=http://127.0.0.1:4191

# 只读 FR 敞口提示，不触发 dump、清仓或外部通知。独立于下架自动处理阈值。
DELIST_EXPOSURE_INTERVAL_SECS=10
DELIST_EXPOSURE_MAX_AGE_SECS=90
DELIST_EXPOSURE_PERSISTENCE_SECS=30
DELIST_DATA_PERSISTENCE_SECS=60
DELIST_EXPOSURE_ASSET_LIMIT_USDT=100
DELIST_EXPOSURE_ACCOUNT_LIMIT_USDT=500

# 同一钉钉机器人接收当前 CTA Prep／Spread 备份失败及恢复；旧归档状态不推送。
# Independent FR DingTalk robot; URL and signing secret belong only in the
# environment-local config/fr_dingtalk.env (owned by service user, mode 0600):
#   FR_DINGTALK_WEBHOOK_URL=...
#   FR_DINGTALK_SECRET=...
DELIST_FR_NOTIFY_ENABLED=1

# 每个 FR 盘 {slug}:fr_unimmr_close_symbols 的空表巡检：key 缺失或列表为空时
# 推送 Telegram（需 PRE_TRADE_NOTIFICATION_URL），持续为空每小时重复一次。
DELIST_UNIMMR_LIST_INTERVAL_SECS=60

# 实际下架前 24 小时：两腿绝对仓位较大值 <= 1000U 时自动执行 clear；
# > 1000U 只推送 Telegram 并在页面提供人工按钮。自动执行会真实下单。
# 自动和人工操作都写入 PostgreSQL delist_flatten_audit。
DELIST_AUTO_FLATTEN_POSITION_RISK=0
DELIST_FLATTEN_WINDOW_HOURS=24
DELIST_FLATTEN_MANUAL_THRESHOLD_USDT=1000
DELIST_FLATTEN_ENV_ROOT=/home/ubuntu
DELIST_FLATTEN_TIMEOUT_SECS=300

# 自动 flatten 要求本机 notification_server 可用。人工按钮还要求独立操作口令。
PRE_TRADE_NOTIFICATION_URL=http://127.0.0.1:18100/v1/notify
PRE_TRADE_NOTIFICATION_TIMEOUT_MS=1000
NOTIFICATION_API_TOKEN=
DELIST_FLATTEN_API_TOKEN=

# SG 上的 Bybit 名单必须经 SSH loopback 隧道读取；不要将 Redis 6379 暴露到公网。
# 该隧道仅在设置 DELIST_SG_REDIS_URL 后由 start_delist_risk_server.sh 创建。
# DELIST_SG_REDIS_URL=redis://127.0.0.1:16379/0
# DELIST_SG_REDIS_SSH_HOST=sg
# DELIST_SG_REDIS_TUNNEL_PORT=16379
# DELIST_SG_REDIS_TUNNEL_NAME=delist_sg_redis_tunnel
# Optional: forward SG's loopback web gateway for authenticated JP FR routes.
# SG must restrict /fr/bybit_fr_*/ to loopback and bind its backends to loopback.
# DELIST_SG_WEB_TUNNEL_PORT=14191
# Enable only after the SG env's flatten_bybit_pm.py and trade_engine.toml are deployed.
# DELIST_SG_FLATTEN_SSH_HOST=sg

# LLM（OpenAI Responses 兼容）。失败只记状态，不拦拉取。
DELIST_LLM_API_URL=
DELIST_LLM_API_KEY=
DELIST_LLM_MODEL=gpt-5.6-luna
DELIST_LLM_REASONING_EFFORT=xhigh
DELIST_LLM_BACKUP_API_URL=
DELIST_LLM_BACKUP_API_KEY=
DELIST_LLM_BACKUP_MODEL=gpt-5.6-luna

# 可选：币安 SAPI 现货/杠杆下架表。没有 key 时 binance-margin 官方快照会失败并出现在 /v1/status。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 0 = 不限制每次启动后的 LLM 次数。
DELIST_LLM_MAX=0
# 逗号分隔 announcement id；启动时强制重抽（即使上次 LLM 成功）。
# DELIST_FORCE_LLM_IDS=fab1676df7fb464a9e4634c6f777659e
RUST_LOG=info
